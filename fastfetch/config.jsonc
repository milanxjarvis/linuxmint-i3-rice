{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/cg.png",
        "height": 20,
        "width": 35,
        "padding": {
            "top": 2,
            "right": 6
        }
    },

    "display": {
        "separator": " "
    },

    "modules": [
    "break",
    "break",
    "break",

    {
        "type": "custom",
        "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
    },

    "break",

    {
        "type": "title",
        "keyWidth": 10
    },

    "break",

    {
        "type": "os",
        "key": "󰣭 ",
        "keyColor": "34"
    },
    {
        "type": "kernel",
        "key": " ",
        "keyColor": "34"
    },
    {
        "type": "shell",
        "key": " ",
        "keyColor": "34"
    },
    {
        "type": "terminal",
        "key": " ",
        "keyColor": "34"
    },
    {
        "type": "de",
        "key": "󰧨 ",
        "keyColor": "34"
    },
   {
    "type": "cpu",
    "key": " ",
    "keyColor": "34"
  },
  {
    "type": "gpu",
    "key": "󰢮 ",
    "keyColor": "34"
  },
  {
    "type": "memory",
    "key": "󰍛 ",
    "keyColor": "34"
  },
  {
    "type": "disk",
    "key": " ",
    "keyColor": "34"
  }, 
  {
        "type": "media",
        "key": "󰝚 ",
        "keyColor": "34",
        "format": "{title} - {artist}"
    },
    {
        "type": "player",
        "key": "󰓇 ",
        "keyColor": "34"
      
    },
    
    "break",

    {
        "type": "custom",
        "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
    },

    "break",
    "break"
]
}
